# Supabase Configuration
# Get these from your Supabase project settings: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Instructions:
# 1. Copy this file and rename to .env
# 2. Replace the values with your actual Supabase credentials
# 3. Go to Supabase Dashboard -> Authentication -> URL Configuration
# 4. Add http://localhost:8080 to Site URL and Redirect URLs

# AI keys for the reading assistant: Gemini (https://aistudio.google.com/app/apikey) and
# OpenRouter (https://openrouter.ai/keys). SERVER-ONLY: never prefix these with VITE_, or Vite
# bundles them into the public JavaScript. Add them in Vercel -> Settings -> Environment
# Variables too. Every key set joins one rotation across both providers.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
OPENROUTER_API_KEY=
# Optional: comma-separated OpenRouter model ids to use instead of the free defaults
# OPENROUTER_MODELS=
